// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  PROFESORA
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum AlcanceActividad {
  SEMANAL
  DIARIA
}

model Usuario {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  rol       Rol
  estado    Estado    @default(ACTIVO)
  profesora Profesora?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Profesora {
  id        String   @id @default(cuid())
  nombre    String
  documento String   @unique
  telefono  String
  fotoUrl   String?
  estado    Estado   @default(ACTIVO)

  usuarioId String? @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  gruposComoPrincipal Grupo[]           @relation("ProfesoraPrincipal")
  gruposComoAuxiliar  Grupo[]           @relation("ProfesoraAuxiliar")
  reportesSemanales   ReporteSemanal[]
  reportesEspeciales  ReporteEspecial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grupo {
  id          String @id @default(cuid())
  descripcion String
  estado      Estado @default(ACTIVO)

  profesoraPrincipalId String
  profesoraPrincipal   Profesora @relation("ProfesoraPrincipal", fields: [profesoraPrincipalId], references: [id])

  profesoraAuxiliarId String?
  profesoraAuxiliar   Profesora? @relation("ProfesoraAuxiliar", fields: [profesoraAuxiliarId], references: [id])

  ninos Nino[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Nino {
  id              String   @id @default(cuid())
  nombre          String
  fechaNacimiento DateTime

  nombrePapa  String?
  celularPapa String?
  correoPapa  String?

  nombreMama  String?
  celularMama String?
  correoMama  String?

  fotoUrl     String?
  horaEntrega String? // formato "HH:mm"
  estado      Estado  @default(ACTIVO)

  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id])

  reportesSemanales  ReporteSemanal[]
  reportesEspeciales ReporteEspecial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Actividad {
  id      String           @id @default(cuid())
  nombre  String
  alcance AlcanceActividad @default(SEMANAL)
  orden   Int              @default(0)
  estado  Estado           @default(ACTIVO)

  observaciones      ObservacionActividad[]
  reportesEspeciales ReporteEspecial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReporteSemanal {
  id String @id @default(cuid())

  ninoId String
  nino   Nino   @relation(fields: [ninoId], references: [id])

  profesoraId String
  profesora   Profesora @relation(fields: [profesoraId], references: [id])

  fechaInicio DateTime
  fechaFin    DateTime

  comentarioGeneral String?

  enviadoEmail Boolean @default(false)
  enviadoA     String?

  observaciones ObservacionActividad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ninoId, fechaInicio])
}

model ObservacionActividad {
  id String @id @default(cuid())

  reporteId String
  reporte   ReporteSemanal @relation(fields: [reporteId], references: [id])

  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id])

  observacion String
  fotoUrl     String?

  createdAt DateTime @default(now())
}

model ReporteEspecial {
  id String @id @default(cuid())

  ninoId String
  nino   Nino   @relation(fields: [ninoId], references: [id])

  profesoraId String
  profesora   Profesora @relation(fields: [profesoraId], references: [id])

  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id])

  fecha      DateTime
  comentario String?

  enviadoEmail Boolean @default(false)
  enviadoA     String?

  fotos FotoReporteEspecial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FotoReporteEspecial {
  id String @id @default(cuid())

  reporteId String
  reporte   ReporteEspecial @relation(fields: [reporteId], references: [id])

  fotoUrl String

  createdAt DateTime @default(now())
}
